# Copia este archivo a .env y coloca las credenciales de tu proyecto de Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
VITE_DEFAULT_TIMEZONE=America/Mexico_City

# URL pública HTTPS o ruta local de la fotografía REAL autorizada del consultorio MINA.
# No usar fotografías de pacientes ni documentos clínicos en esta variable.
VITE_MINA_CONSULTORIO_PHOTO_URL=
